NODE_ENV=development
PORT=3000
# URL pública del front (se usa en los enlaces de invitación y recuperación)
APP_URL=http://localhost:5173
DATABASE_URL=postgres://alcombar:alcombar_dev@localhost:5433/alcombar
DATABASE_SSL=false
# Clave para firmar los tokens de acceso. En producción, una cadena larga y aleatoria.
JWT_SECRET=cambiar-por-una-clave-larga-y-aleatoria
# Primer superadmin (lo crea el seed si no existe)
SUPERADMIN_EMAIL=admin@alcombar.local
SUPERADMIN_NAME=Superadmin
SUPERADMIN_PASSWORD=
# Alternativa: email por SMTP (Gmail con contraseña de aplicación). Se usa solo si no hay RESEND_API_KEY.
# Para otro proveedor, completar SMTP_HOST y SMTP_PORT.
SMTP_USER=
SMTP_PASS=
SMTP_HOST=
SMTP_PORT=465
# Email por Resend (API HTTPS: funciona en Railway). MAIL_FROM tiene que ser de un dominio verificado en Resend.
RESEND_API_KEY=
MAIL_FROM_NAME=ALCOMBAR Gestión
MAIL_FROM=info@wearesrv.com
# Las respuestas a los mails llegan a esta casilla
MAIL_REPLY_TO=
# Reportes de problemas: adónde avisar por mail cada reporte nuevo (opcional)
SUPPORT_EMAIL=
