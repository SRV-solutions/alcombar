{
  "name": "alcombar-api",
  "version": "0.1.0",
  "private": true,
  "description": "ALCOMBAR Gestión — API (Express + Sequelize + PostgreSQL)",
  "scripts": {
    "predev": "node scripts/db.mjs start && sequelize-cli db:migrate && tsx src/seed.ts",
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsup src/index.ts src/seed.ts --format cjs --target node20 --clean",
    "start": "node dist/index.js",
    "db:start": "node scripts/db.mjs start",
    "db:stop": "node scripts/db.mjs stop",
    "migrate": "sequelize-cli db:migrate",
    "migrate:undo": "sequelize-cli db:migrate:undo",
    "seed": "tsx src/seed.ts",
    "db:reset": "node scripts/db.mjs start && sequelize-cli db:migrate:undo:all && sequelize-cli db:migrate && tsx src/seed.ts",
    "typecheck": "tsc --noEmit",
    "import:personas": "tsx src/scripts/importPersonas.ts",
    "superadmin": "tsx src/scripts/superadmin.ts",
    "adultos:unidades": "tsx src/scripts/adultosPorUnidad.ts",
    "adultos:formacion": "tsx src/scripts/formacionAdultos.ts",
    "mail:test": "tsx src/scripts/mailTest.ts",
    "seed:prod": "node dist/seed.js",
    "db:backup": "node scripts/db-backup.mjs",
    "db:restore": "node scripts/db-restore.mjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.6.0",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.5",
    "sequelize-cli": "^6.6.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^8.0.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
